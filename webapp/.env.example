# Copy to .env for local development. Real values live in Vercel → Settings →
# Environment Variables. Never commit the filled-in file.

# ── Server only (never exposed to the browser) ────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
META_CAPI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# The whole service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Exposed to the browser (VITE_ prefix) ─────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Absolute site URL used for canonical + Open Graph tags. On Vercel this is
# derived automatically from VERCEL_PROJECT_PRODUCTION_URL, so you only need to
# set it if you want to override that (e.g. a custom apex domain).
# VITE_SITE_URL=https://your-domain.com
